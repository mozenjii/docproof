[
  {
    "id": "text-collapse-and-strip-ws",
    "fn": "normalize_text",
    "args": {
      "s": "  Hello   World  "
    },
    "expected": "hello world",
    "why": "8.1 casefold; whitespace runs -> one space; strip ends"
  },
  {
    "id": "text-tabs-newlines",
    "fn": "normalize_text",
    "args": {
      "s": "Net\t\n 30\r\ndays"
    },
    "expected": "net 30 days",
    "why": "8.1 every run of whitespace becomes one space"
  },
  {
    "id": "text-trailing-period",
    "fn": "normalize_text",
    "args": {
      "s": "Net 30."
    },
    "expected": "net 30",
    "why": "8.1 strip trailing punctuation ."
  },
  {
    "id": "text-nested-brackets-quotes",
    "fn": "normalize_text",
    "args": {
      "s": "\"(Net 30 days)\""
    },
    "expected": "net 30 days",
    "why": "8.1 strip \" ( ) repeatedly from both ends"
  },
  {
    "id": "text-all-bracket-kinds",
    "fn": "normalize_text",
    "args": {
      "s": "{[(x)]}"
    },
    "expected": "x",
    "why": "8.1 strip ()[]{} repeatedly"
  },
  {
    "id": "text-mixed-ws-and-punct-ends",
    "fn": "normalize_text",
    "args": {
      "s": "  .  hello  .  "
    },
    "expected": "hello",
    "why": "8.1 strip whitespace and punctuation from both ends repeatedly"
  },
  {
    "id": "text-strip-dash-underscore-slash",
    "fn": "normalize_text",
    "args": {
      "s": "--__//x//__--"
    },
    "expected": "x",
    "why": "8.1 - _ / are in the strip set"
  },
  {
    "id": "text-single-quotes",
    "fn": "normalize_text",
    "args": {
      "s": "'quoted'"
    },
    "expected": "quoted",
    "why": "8.1 ' in strip set"
  },
  {
    "id": "text-internal-punct-kept",
    "fn": "normalize_text",
    "args": {
      "s": "A.B-C"
    },
    "expected": "a.b-c",
    "why": "8.1 only ends are stripped"
  },
  {
    "id": "text-internal-comma-kept",
    "fn": "normalize_text",
    "args": {
      "s": "Hello, World!"
    },
    "expected": "hello, world",
    "why": "8.1 trailing ! stripped, internal , kept"
  },
  {
    "id": "text-internal-spaced-dash",
    "fn": "normalize_text",
    "args": {
      "s": "x  -  y"
    },
    "expected": "x - y",
    "why": "8.1 internal whitespace collapsed, internal - kept"
  },
  {
    "id": "text-only-punct",
    "fn": "normalize_text",
    "args": {
      "s": "...!?"
    },
    "expected": "",
    "why": "8.1 everything is strippable punctuation"
  },
  {
    "id": "text-empty",
    "fn": "normalize_text",
    "args": {
      "s": ""
    },
    "expected": "",
    "why": "8.1 empty stays empty"
  },
  {
    "id": "text-hash-not-stripped",
    "fn": "normalize_text",
    "args": {
      "s": "#123"
    },
    "expected": "#123",
    "why": "8.1 # is not in the strip set"
  },
  {
    "id": "text-percent-not-stripped",
    "fn": "normalize_text",
    "args": {
      "s": "50%"
    },
    "expected": "50%",
    "why": "8.1 % is not in the strip set"
  },
  {
    "id": "text-asterisk-not-stripped",
    "fn": "normalize_text",
    "args": {
      "s": "*note*"
    },
    "expected": "*note*",
    "why": "8.1 * is not in the strip set"
  },
  {
    "id": "text-fullwidth-letters",
    "fn": "normalize_text",
    "args": {
      "s": "ＡＢＣ"
    },
    "expected": "abc",
    "why": "8.1 NFKC maps fullwidth, then casefold"
  },
  {
    "id": "text-fullwidth-parens",
    "fn": "normalize_text",
    "args": {
      "s": "（x）"
    },
    "expected": "x",
    "why": "8.1 NFKC maps fullwidth parens to ( ) which are stripped"
  },
  {
    "id": "text-ellipsis-char",
    "fn": "normalize_text",
    "args": {
      "s": "wait…"
    },
    "expected": "wait",
    "why": "8.1 NFKC maps U+2026 to ... which is stripped"
  },
  {
    "id": "text-ligature",
    "fn": "normalize_text",
    "args": {
      "s": "ﬁle"
    },
    "expected": "file",
    "why": "8.1 NFKC decomposes the fi ligature"
  },
  {
    "id": "text-roman-numeral",
    "fn": "normalize_text",
    "args": {
      "s": "Ⅻ"
    },
    "expected": "xii",
    "why": "8.1 NFKC maps U+216B to XII, casefold"
  },
  {
    "id": "text-casefold-sharp-s",
    "fn": "normalize_text",
    "args": {
      "s": "Straße"
    },
    "expected": "strasse",
    "why": "8.1 casefold (not lower) maps ß to ss"
  },
  {
    "id": "text-nbsp",
    "fn": "normalize_text",
    "args": {
      "s": " Net  30 "
    },
    "expected": "net 30",
    "why": "8.1 NFKC maps NBSP to space; collapse and strip"
  },
  {
    "id": "text-ideographic-space",
    "fn": "normalize_text",
    "args": {
      "s": "　x　y"
    },
    "expected": "x y",
    "why": "8.1 NFKC maps U+3000 to space"
  },
  {
    "id": "id-hyphen-slash",
    "fn": "normalize_identifier",
    "args": {
      "s": "inv-2026/001"
    },
    "expected": "INV2026001",
    "why": "8.1 uppercase; remove - and /"
  },
  {
    "id": "id-all-removed-chars",
    "fn": "normalize_identifier",
    "args": {
      "s": "A.B C-D/E"
    },
    "expected": "ABCDE",
    "why": "8.1 remove spaces - . /"
  },
  {
    "id": "id-no-o0-fold",
    "fn": "normalize_identifier",
    "args": {
      "s": "INV-0O1I"
    },
    "expected": "INV0O1I",
    "why": "8.1/4 O/0 and I/1 are NOT folded"
  },
  {
    "id": "id-lowercase-o-l-kept",
    "fn": "normalize_identifier",
    "args": {
      "s": "po-o0l1"
    },
    "expected": "POO0L1",
    "why": "8.1 uppercase only; no O/0 or l/1 folding"
  },
  {
    "id": "id-fullwidth",
    "fn": "normalize_identifier",
    "args": {
      "s": "ｉｎｖ１２"
    },
    "expected": "INV12",
    "why": "8.1 NFKC then uppercase"
  },
  {
    "id": "id-fullwidth-hyphen-minus",
    "fn": "normalize_identifier",
    "args": {
      "s": "A－1"
    },
    "expected": "A1",
    "why": "8.1 NFKC maps U+FF0D to - which is removed"
  },
  {
    "id": "id-fullwidth-solidus",
    "fn": "normalize_identifier",
    "args": {
      "s": "A／1"
    },
    "expected": "A1",
    "why": "8.1 NFKC maps U+FF0F to / which is removed"
  },
  {
    "id": "id-numero-sign",
