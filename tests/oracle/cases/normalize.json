  {
    "id": "money-pad-usd",
    "fn": "normalize_money",
    "args": {
      "amount": "12.5",
      "currency": "usd"
    },
    "expected": {
      "amount": "12.50",
      "currency": "USD"
    },
    "why": "8.1 currency uppercased; quantised to 2 decimals"
  },
  {
    "id": "money-integer-usd",
    "fn": "normalize_money",
    "args": {
      "amount": "12",
      "currency": "USD"
    },
    "expected": {
      "amount": "12.00",
      "currency": "USD"
    },
    "why": "8.1 quantised to 2 decimals"
  },
  {
    "id": "money-exact-usd",
    "fn": "normalize_money",
    "args": {
      "amount": "12.50",
      "currency": "USD"
    },
    "expected": {
      "amount": "12.50",
      "currency": "USD"
    },
    "why": "8.1 already at minor unit"
  },
